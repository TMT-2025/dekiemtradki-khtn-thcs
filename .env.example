# ============================================================
# KHTN ASSESSMENT STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# IMPORTANT:
# - Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JS.
# - DO NOT place secrets or private keys in NEXT_PUBLIC_ variables.
# - In production, SUPABASE_REQUIRED must be set to 'true' to prevent silent JSON fallback.
# ============================================================

# ------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Safe for browser exposure)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://khtn-assessment.edu.vn
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER EXPOSE TO CLIENT OR REPOSITORIES)
# ------------------------------------------------------------
# Supabase admin / elevated access (Server-only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database safety gate (When true, application will FAIL FAST if Supabase is unconfigured)
SUPABASE_REQUIRED=false

# Primary AI Provider (Multi-provider architecture: GEMINI | OPENAI | ANTHROPIC)
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Optional alternative AI keys (Server-only)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & Session Secrets (Server-only)
JWT_SECRET=generate-a-strong-random-secret-at-least-32-chars
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ------------------------------------------------------------
# 3. RUNTIME & SYSTEM
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000
